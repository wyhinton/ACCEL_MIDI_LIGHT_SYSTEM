{
  // PlatformIO upload task for the sender board, plus the host audio bridge
  // and git helpers. Run via Terminal > Run Task...
  "version": "2.0.0",
  "tasks": [
    {
      "label": "📤 Upload to Sender",
      "type": "shell",
      "command": "pio",
      "windows": {
        "command": "${env:USERPROFILE}/.platformio/penv/Scripts/pio.exe"
      },
      "args": ["run", "--target", "upload", "--project-dir", "${workspaceFolder}/ACCELERATION_LIGHT_SENDER_REAL"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "🎧 Run Audio Bridge",
      "type": "shell",
      "command": "uv",
      "args": ["run", "${workspaceFolder}/host/audio_bridge.py", "--device", "${input:audioDevice}"],
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "clear": true, "reveal": "always" }
    },
    {
      "label": "🔁 Run Audio Bridge (Windows Loopback)",
      "type": "shell",
      "command": "uv",
      "args": ["run", "${workspaceFolder}/host/audio_bridge.py", "--loopback", "--device", "${input:loopbackDevice}"],
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "clear": true, "reveal": "always" }
    },
    {
      "label": "🎹 Run MIDI Status UI",
      "type": "shell",
      "command": "uv",
      "args": ["run", "${workspaceFolder}/host/midi_status_ui.py"],
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "clear": true, "reveal": "always" }
    },
    {
      "label": "⬇️ Git Pull",
      "type": "shell",
      "command": "git pull",
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "🚀 Quick Commit & Push",
      "type": "shell",
      "command": "git add -A && git commit -m '${input:commitMessage}' && git push",
      "windows": {
        "command": "git add -A; if ($?) { git commit -m '${input:commitMessage}' }; if ($?) { git push }",
        "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } }
      },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "audioDevice",
      "type": "promptString",
      "description": "Audio input device name or index (e.g. BlackHole). Leave blank for system default.",
      "default": "BlackHole"
    },
    {
      "id": "loopbackDevice",
      "type": "promptString",
      "description": "Windows: output device name/index to loop back (e.g. Speakers, Headphones). Leave blank for the system default output.",
      "default": ""
    },
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Commit message",
      "default": "quick commit"
    }
  ]
}
