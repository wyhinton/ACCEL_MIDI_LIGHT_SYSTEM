{
  // PlatformIO upload tasks, one per board. Run via Terminal > Run Task...
  // Each builds and flashes the firmware for that project directory.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Upload to Multiplex",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/scripts/pio.sh",
      "windows": { "command": "${workspaceFolder}/.vscode/scripts/pio.bat" },
      "args": ["run", "--target", "upload", "--project-dir", "${workspaceFolder}/MULTIPLEX_8266"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Upload & Monitor Multiplex",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/scripts/pio.sh",
      "windows": { "command": "${workspaceFolder}/.vscode/scripts/pio.bat" },
      "args": ["run", "--target", "upload", "--target", "monitor", "--project-dir", "${workspaceFolder}/MULTIPLEX_8266"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Monitor Multiplex",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/scripts/pio.sh",
      "windows": { "command": "${workspaceFolder}/.vscode/scripts/pio.bat" },
      "args": ["device", "monitor", "--project-dir", "${workspaceFolder}/MULTIPLEX_8266"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Erase Multiplex",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/scripts/pio.sh",
      "windows": { "command": "${workspaceFolder}/.vscode/scripts/pio.bat" },
      "args": ["run", "--target", "erase", "--project-dir", "${workspaceFolder}/MULTIPLEX_8266"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Upload to Extender",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/scripts/pio.sh",
      "windows": { "command": "${workspaceFolder}/.vscode/scripts/pio.bat" },
      "args": ["run", "--target", "upload", "--project-dir", "${workspaceFolder}/MOSFET_EXTENDER_8266"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Upload & Monitor Extender",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/scripts/pio.sh",
      "windows": { "command": "${workspaceFolder}/.vscode/scripts/pio.bat" },
      "args": ["run", "--target", "upload", "--target", "monitor", "--project-dir", "${workspaceFolder}/MOSFET_EXTENDER_8266"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Erase Extender",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/scripts/pio.sh",
      "windows": { "command": "${workspaceFolder}/.vscode/scripts/pio.bat" },
      "args": ["run", "--target", "erase", "--project-dir", "${workspaceFolder}/MOSFET_EXTENDER_8266"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Upload to Midi Light",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/scripts/pio.sh",
      "windows": { "command": "${workspaceFolder}/.vscode/scripts/pio.bat" },
      "args": ["run", "--target", "upload", "--project-dir", "${workspaceFolder}/MIDI_NOTE_LIGHT_REAL"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Upload & Monitor Midi Light",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/scripts/pio.sh",
      "windows": { "command": "${workspaceFolder}/.vscode/scripts/pio.bat" },
      "args": ["run", "--target", "upload", "--target", "monitor", "--project-dir", "${workspaceFolder}/MIDI_NOTE_LIGHT_REAL"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Monitor Midi Light",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/scripts/pio.sh",
      "windows": { "command": "${workspaceFolder}/.vscode/scripts/pio.bat" },
      "args": ["device", "monitor", "--project-dir", "${workspaceFolder}/MIDI_NOTE_LIGHT_REAL"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Erase Midi Light",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/scripts/pio.sh",
      "windows": { "command": "${workspaceFolder}/.vscode/scripts/pio.bat" },
      "args": ["run", "--target", "erase", "--project-dir", "${workspaceFolder}/MIDI_NOTE_LIGHT_REAL"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Upload to Relay PWM",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/scripts/pio.sh",
      "windows": { "command": "${workspaceFolder}/.vscode/scripts/pio.bat" },
      "args": ["run", "--target", "upload", "--project-dir", "${workspaceFolder}/RELAY_PWM_8266"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Upload & Monitor Relay PWM",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/scripts/pio.sh",
      "windows": { "command": "${workspaceFolder}/.vscode/scripts/pio.bat" },
      "args": ["run", "--target", "upload", "--target", "monitor", "--project-dir", "${workspaceFolder}/RELAY_PWM_8266"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Monitor Relay PWM",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/scripts/pio.sh",
      "windows": { "command": "${workspaceFolder}/.vscode/scripts/pio.bat" },
      "args": ["device", "monitor", "--project-dir", "${workspaceFolder}/RELAY_PWM_8266"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Erase Relay PWM",
      "type": "shell",
      "command": "${workspaceFolder}/.vscode/scripts/pio.sh",
      "windows": { "command": "${workspaceFolder}/.vscode/scripts/pio.bat" },
      "args": ["run", "--target", "erase", "--project-dir", "${workspaceFolder}/RELAY_PWM_8266"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Run Light Chase UI",
      "type": "shell",
      "command": "npm",
      "args": ["run", "dev"],
      "options": { "cwd": "${workspaceFolder}/LIGHT_CHASE_UI" },
      "isBackground": true,
      "problemMatcher": {
        "owner": "light-chase-ui",
        "pattern": {
          "regexp": "^ERROR$",
          "file": 1,
          "location": 2,
          "message": 3
        },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "VITE v",
          "endsPattern": "ready in"
        }
      },
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Debug Log over WiFi (Mac)",
      "type": "shell",
      "command": "nc",
      "args": ["192.168.4.1", "23"],
      "isBackground": true,
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Quick Commit & Push",
      "type": "shell",
      "command": "git add -A; if ($?) { git commit -m '${input:commitMessage}' }; if ($?) { git push -u origin HEAD }",
      "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Start Wi-Fi Auto-Reconnect",
      "type": "shell",
      "command": "launchctl load -w ~/Library/LaunchAgents/com.wyhinton.wifireconnect.plist && echo 'Wi-Fi auto-reconnect started (checks every 30s).'",
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Stop Wi-Fi Auto-Reconnect",
      "type": "shell",
      "command": "launchctl unload -w ~/Library/LaunchAgents/com.wyhinton.wifireconnect.plist && echo 'Wi-Fi auto-reconnect stopped.'",
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Commit message",
      "default": "quick commit"
    }
  ]
}
