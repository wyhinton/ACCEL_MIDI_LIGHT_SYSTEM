{
  // PlatformIO upload tasks, one per board. Run via Terminal > Run Task...
  // Each builds and flashes the firmware for that project directory.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Upload to Multiplex",
      "type": "shell",
      "command": "${env:USERPROFILE}/.platformio/penv/Scripts/pio.exe",
      "args": ["run", "--target", "upload", "--project-dir", "${workspaceFolder}/MULTIPLEX_8266"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Upload & Monitor Multiplex",
      "type": "shell",
      "command": "${env:USERPROFILE}/.platformio/penv/Scripts/pio.exe",
      "args": ["run", "--target", "upload", "--target", "monitor", "--project-dir", "${workspaceFolder}/MULTIPLEX_8266"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Monitor Multiplex",
      "type": "shell",
      "command": "${env:USERPROFILE}/.platformio/penv/Scripts/pio.exe",
      "args": ["device", "monitor", "--project-dir", "${workspaceFolder}/MULTIPLEX_8266"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Upload to Extender",
      "type": "shell",
      "command": "${env:USERPROFILE}/.platformio/penv/Scripts/pio.exe",
      "args": ["run", "--target", "upload", "--project-dir", "${workspaceFolder}/MOSFET_EXTENDER_8266"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Upload & Monitor Extender",
      "type": "shell",
      "command": "${env:USERPROFILE}/.platformio/penv/Scripts/pio.exe",
      "args": ["run", "--target", "upload", "--target", "monitor", "--project-dir", "${workspaceFolder}/MOSFET_EXTENDER_8266"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Quick Commit & Push",
      "type": "shell",
      "command": "git add -A; if ($?) { git commit -m '${input:commitMessage}' }; if ($?) { git push }",
      "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Commit message",
      "default": "quick commit"
    }
  ]
}
