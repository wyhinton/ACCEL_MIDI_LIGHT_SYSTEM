{
  // PlatformIO upload tasks, one per board. Run via Terminal > Run Task...
  // Each builds and flashes the firmware for that project directory.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Upload to Sender",
      "type": "shell",
      "command": "${env:USERPROFILE}/.platformio/penv/Scripts/pio.exe",
      "args": ["run", "--target", "upload", "--project-dir", "${workspaceFolder}/ACCELERATION_LIGHT_SENDER_REAL"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Upload to Receiver",
      "type": "shell",
      "command": "${env:USERPROFILE}/.platformio/penv/Scripts/pio.exe",
      "args": ["run", "--target", "upload", "--project-dir", "${workspaceFolder}/ACCLERATION_LIGHT_RECIEVER_REAL"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Upload to Midi Light",
      "type": "shell",
      "command": "${env:USERPROFILE}/.platformio/penv/Scripts/pio.exe",
      "args": ["run", "--target", "upload", "--project-dir", "${workspaceFolder}/MIDI_NOTE_LIGHT_REAL"],
      "problemMatcher": "$platformio",
      "group": "build",
      "presentation": { "panel": "dedicated", "clear": true }
    },
    {
      "label": "Quick Commit & Push",
      "type": "shell",
      "command": "git add -A; if ($?) { git commit -m '${input:commitMessage}' }; if ($?) { git push }",
      "options": { "shell": { "executable": "powershell.exe", "args": ["-NoProfile", "-Command"] } },
      "problemMatcher": [],
      "presentation": { "panel": "dedicated", "clear": true }
    }
  ],
  "inputs": [
    {
      "id": "commitMessage",
      "type": "promptString",
      "description": "Commit message",
      "default": "quick commit"
    }
  ]
}
